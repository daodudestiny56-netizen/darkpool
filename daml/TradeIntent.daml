module TradeIntent where

template TradeIntent
  with
    trader : Party
    matcher : Party
    asset : Text
    side : Text       -- "BUY" or "SELL"
    quantity : Decimal
    price : Decimal
    expiry : Time
    status : Text     -- "ACTIVE", "MATCHED", "RFQ", "EXPIRED"
  where
    signatory trader
    observer matcher

    choice CancelIntent : ()
      controller trader
      do
        return ()

    choice UpdateStatus : ContractId TradeIntent
      with
        newStatus : Text
      controller matcher
      do
        create this with status = newStatus

    choice SplitIntent : (ContractId TradeIntent, ContractId TradeIntent)
      with
        splitQuantity : Decimal
      controller matcher
      do
        assertMsg "Split quantity must be less than total quantity" (splitQuantity < quantity)
        assertMsg "Split quantity must be positive" (splitQuantity > 0.0)
        
        part1 <- create this with quantity = splitQuantity
        part2 <- create this with quantity = quantity - splitQuantity
        
        return (part1, part2)
